# Reglas de cache inmutable para assets pesados y versionados
/bocho_optimized.glb
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/draco/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Streaming progresivo de video MP4 720p/480p con soporte HTTP 206 Byte-Range
/videos/*
  Accept-Ranges: bytes
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Headers: Range
  Access-Control-Expose-Headers: Content-Range, Content-Length, Accept-Ranges
  Cache-Control: public, max-age=604800

# Reglas para el HTML principal (siempre fresco para detectar nuevos despliegues)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=*, gyroscope=*, magnetometer=*, xr-spatial-tracking=*

/index.html
  Cache-Control: public, max-age=0, must-revalidate
